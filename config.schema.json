{
  "pluginAlias": "ElectraSmartPlatform",
  "pluginType": "platform",
  "customUi": true,
  "singular": true,
  "headerDisplay": "Manage your Electra Smart AC units in HomeKit.",
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "imei": {
        "title": "IMEI",
        "type": "string"
      },
      "token": {
        "title": "Access Token",
        "type": "string"
      },
      "options": {
        "title": "Additional Options",
        "type": "object",
        "properties": {
          "hideDryMode": {
            "title": "Hide Dry Mode Switch",
            "type": "boolean",
            "default": true,
            "description": "Removes the separate Dry Mode switch from the Home app."
          },
          "hideFanMode": {
            "title": "Hide Fan Mode Switch",
            "type": "boolean",
            "default": true,
            "description": "Removes the separate Fan Mode switch from the Home app."
          },
          "pollInterval": {
            "title": "Polling Interval (Seconds)",
            "type": "integer",
            "default": 60,
            "minimum": 30,
            "description": "How often to check for status changes (recommended 60-90s)."
          }
        }
      }
    }
  },
  "layout": [
    "phoneNumber",
    {
      "type": "help",
      "helpvalue": "<button id='otp-btn' class='btn btn-primary'>Request SMS Code</button>"
    },
    "imei",
    "token",
    "options"
  ]
}
