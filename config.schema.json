{
  "pluginAlias": "ElectraSmartPlatform",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "Electra Smart AC Control (V2)",
  "footerDisplay": "For support, visit the GitHub repository.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "Electra Smart AC"
      },
      "imei": {
        "title": "IMEI",
        "type": "string",
        "description": "Your device IMEI (obtained via Login)"
      },
      "token": {
        "title": "Token",
        "type": "string",
        "description": "Your authentication token (obtained via Login)"
      },
      "options": {
        "type": "object",
        "properties": {
          "pollInterval": {
            "title": "Polling Interval (seconds)",
            "type": "integer",
            "default": 60,
            "minimum": 30
          },
          "debug": {
            "title": "Plugin Debug Mode",
            "type": "boolean",
            "default": false,
            "description": "Show detailed plugin logs without enabling debug mode for all of Homebridge."
          },
          "hideDryMode": {
            "title": "Hide Dry Mode",
            "type": "boolean",
            "default": true
          },
          "hideFanMode": {
            "title": "Hide Fan Mode",
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "layout": [
    {
      "key": "name",
      "readonly": true
    },
    {
      "type": "fieldset",
      "title": "Authentication",
      "expandable": false,
      "items": [
        {
          "key": "imei",
          "readonly": true
        },
        {
          "key": "token",
          "readonly": true
        },
        {
          "type": "help",
          "helpValue": "Use the login button below to automatically fetch your IMEI and Token."
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Options",
      "expandable": true,
      "items": [
        {
          "key": "options.pollInterval"
        },
        {
          "key": "options.debug"
        },
        {
          "key": "options.hideDryMode"
        },
        {
          "key": "options.hideFanMode"
        }
      ]
    }
  ]
}
